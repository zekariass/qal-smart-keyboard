# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.iml

# Secrets and local config (never commit)
.env
.env.*
!.env.example
local.properties
*.jks
*.keystore
*.p12
*.pem

# Build outputs
build/
target/
.gradle/
node_modules/
.next/
out/
*.apk
*.aab

# iOS
xcuserdata/
DerivedData/
*.xcuserstate

# Rust
core/target/

# Python
__pycache__/
*.pyc

# Evaluation outputs (may contain provider outputs)
language-data/eval/results*.csv
language-data/eval/*.jsonl

# Pack build (L1.1): dev signing keys must never be committed; build output
language-data/keys/
language-data/build/

# Kotlin Gradle plugin session data
android/.kotlin/

# JVM crash logs (IDE language server, Gradle/Maven forks)
hs_err_pid*.log
replay_pid*.log

# Local dev secrets (run-backend-dev.sh); .env.* does not match this name
infra/scripts/.dev-secrets.env
