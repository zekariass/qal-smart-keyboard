<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ADR 0047: the RevenueCat SDK brings Google's advertising-id library; this app never collects the advertising
         id (no attribution networks), so its permission is removed from the merged manifest. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
</manifest>
