<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- T8.7: the card being shared is staged in files/card_share/ (a copy of a card the user is sharing); never backed up
         or transferred; files/annotate_share/ likewise for the image annotator. The galleries and the annotator's draft are in
         noBackupFilesDir, which the platform excludes. -->
    <cloud-backup>
        <exclude domain="file" path="card_share" />
        <exclude domain="file" path="annotate_share" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="card_share" />
        <exclude domain="file" path="annotate_share" />
    </device-transfer>
</data-extraction-rules>