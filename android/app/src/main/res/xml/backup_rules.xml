<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- T8.7: the card being shared is staged here (a copy of a card the user is sharing); never backed up. -->
    <exclude domain="file" path="card_share" />
    <!-- T8.7: the same for a flattened annotated picture being shared. -->
    <exclude domain="file" path="annotate_share" />
    <!-- T8.15: a saved drawing being shared from the Creative studio. -->
    <exclude domain="file" path="drawing_share" />
    <!-- T8.15 (R-8): the Draw gallery (editable drawings and their PNGs, filesDir/drawings/) stays on the device: it is not
         part of Auto Backup. Any backup of it is the separate opt-in, encrypted one, never this. -->
    <exclude domain="file" path="drawings" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>