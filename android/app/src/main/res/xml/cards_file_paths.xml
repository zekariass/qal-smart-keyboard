<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- T8.7: the card being shared is staged here, and only here, for the share sheet's one-time read grant.
         The gallery's own files (noBackupFilesDir/cards/) are never exposed. card_share/ is excluded from backups
         and device transfer (backup_rules.xml, data_extraction_rules.xml). -->
    <files-path name="card_share" path="card_share/" />
    <!-- T8.7: the image annotator's flattened copy being shared (redactions already burnt in; never the picked original,
         never the draft). The gallery (noBackupFilesDir/annotations/) and the draft are never exposed. Excluded from
         backups and device transfer like card_share/. -->
    <files-path name="annotate_share" path="annotate_share/" />
    <!-- T8.15: a saved drawing's PNG copy being shared from the Creative studio (a copy of the keyboard's exported image;
         the editable drawings in drawings/ and the keyboard's own png/ folder are never exposed by this provider). Excluded
         from backups and device transfer like the other share folders. -->
    <files-path name="drawing_share" path="drawing_share/" />
</paths>
