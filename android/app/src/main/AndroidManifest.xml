<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A2.2: the companion app talks to the API (sign-in). The :ime module must stay network-free
         (NoNetworkTest): the permission lives here only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ADR 0029: voice typing. Asked only when the user taps the keyboard's mic (VoicePermissionActivity); audio
         goes to the phone's speech service, never to Qal. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".QalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QalSmartKeyboard"
        tools:targetApi="33">
        <!-- ADR 0032: localeConfig = the per-app UI languages (Android 13+); below 13 AppLanguage applies the choice. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.QalSmartKeyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ADR 0029: the keyboard opens this (VoiceIntents.ACTION_VOICE_PERMISSION, our package only) because an
             input method cannot show the permission dialog. Its own task, so finishing it returns to the typing app. -->
        <activity
            android:name=".voice.VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/voice_perm_title"
            android:taskAffinity=""
            android:theme="@style/Theme.QalSmartKeyboard">
            <intent-filter>
                <action android:name="com.qalsmartkeyboard.action.VOICE_PERMISSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ADR 0047: the hosted-checkout WebView checks every page against Google Safe Browsing. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />

        <!-- ADR 0024: Sentry starts only from QalApplication (a DSN in the build AND the privacy switch on), never by
             itself. Auto-init off, and the SDK's start-up providers are removed from the merged manifest. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />
    </application>

</manifest>