<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A2.2: the companion app talks to the API (sign-in). The :ime module must stay network-free
         (NoNetworkTest): the permission lives here only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ADR 0029: voice typing. Asked only when the user taps the keyboard's mic (VoicePermissionActivity); audio
         goes to the phone's speech service, never to Qal. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".QalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QalSmartKeyboard"
        tools:targetApi="33">
        <!-- ADR 0032: localeConfig = the per-app UI languages (Android 13+); below 13 AppLanguage applies the choice. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.QalSmartKeyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ADR 0029: the keyboard opens this (VoiceIntents.ACTION_VOICE_PERMISSION, our package only) because an
             input method cannot show the permission dialog. Its own task, so finishing it returns to the typing app. -->
        <activity
            android:name=".voice.VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/voice_perm_title"
            android:taskAffinity=""
            android:theme="@style/Theme.QalSmartKeyboard">
            <intent-filter>
                <action android:name="com.qalsmartkeyboard.action.VOICE_PERMISSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ADR 0047 (M4.11): the provider's checkout runs in a Chrome Custom Tab; its done button lands here. The
             activity only brings MainActivity forward (the plans screen then confirms with the server). -->
        <activity
            android:name=".billing.BillingReturnActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="qalkeyboard"
                    android:host="billing"
                    android:path="/return" />
            </intent-filter>
        </activity>

        <!-- T8.7: a quote or greeting card, or an annotated picture (always the flattened copy), the user shares is handed
             to the share sheet by this provider. Only files/card_share/ and files/annotate_share/ are exposed, only by a
             URI grant given on the user's tap; nothing is uploaded. -->
        <provider
            android:name=".creative.cards.CardFileProvider"
            android:authorities="${applicationId}.cards"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cards_file_paths" />
        </provider>

        <!-- ADR 0024: Sentry starts only from QalApplication (a DSN in the build AND the privacy switch on), never by
             itself. Auto-init off, and the SDK's start-up providers are removed from the merged manifest. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />
    </application>

</manifest>