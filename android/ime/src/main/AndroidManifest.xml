<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice typing (ADR 0029): Android 11+ package visibility for the speech services (SpeechRecognizer IPC). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application>
        <service
            android:name="com.qalsmartkeyboard.ime.KeyboardImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- T8.4: Draw & Sketch and the QR panel hand an exported PNG to the host app (commitContent) or the share sheet.
             Only drawings/png/ of the app-private files is exposed, only by a URI grant given on the user's tap. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.drawings"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/draw_file_paths" />
        </provider>
    </application>

</manifest>
