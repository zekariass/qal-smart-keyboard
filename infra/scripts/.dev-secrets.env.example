# Copy to infra/scripts/.dev-secrets.env (git-ignored) and fill in. Read by run-backend-dev.sh; the environment wins.
# OpenAI API key for the real LLM provider (leave blank to keep the mock/other providers).
QAL_OPENAI_API_KEY=
# OpenAI model used for text actions, translation and drafts.
QAL_OPENAI_MODEL=gpt-6-luna
# Reasoning effort sent to the model (none, low, medium, high).
QAL_OPENAI_REASONING_EFFORT=none
# Google Cloud Translation API key (fast fallback for translation).
QAL_GOOGLE_TRANSLATE_API_KEY=
# Sentry DSN for crash reporting (blank = off).
QAL_SENTRY_DSN=
# ArifPay SANDBOX API key (ADR 0045; blank = no ArifPay adapter). Never a production key here.
ARIFPAY_SECRET_KEY=
# Billing country for local testing (ADR 0045), e.g. ET; refused under prod/production/staging.
DEV_MOCK_COUNTRY=
# Public origin providers call back (notify/return URLs), e.g. an https tunnel to this machine.
QAL_PUBLIC_BASE_URL=
