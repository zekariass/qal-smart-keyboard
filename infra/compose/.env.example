# Copy to .env to override. Every value has the same default inside docker-compose.yml,
# so the stack starts without a .env file. DEV-ONLY credentials, never reuse elsewhere.
POSTGRES_HOST_PORT=5434
POSTGRES_DB=qal
POSTGRES_USER=qal
POSTGRES_PASSWORD=qal_dev_only

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=qal_minio
MINIO_ROOT_PASSWORD=qal_minio_dev_only

WIREMOCK_PORT=8089
