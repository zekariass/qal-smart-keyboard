{
  "name": "sms-ethiopia: v2 send accepted (any 2519XXXXXXXX with a KEY header)",
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/api/v2/sms/send",
    "headers": { "KEY": { "matches": ".+" } },
    "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.msisdn", "matches": "^2519[0-9]{8}$" } } ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json; charset=utf-8" },
    "jsonBody": {
      "id": "{{randomValue length=26 type='ALPHANUMERIC' uppercase=true}}",
      "segments": 1,
      "status": "ACCEPTED"
    },
    "transformers": ["response-template"]
  }
}
