{
  "name": "ai: scenario error (any /ai/ endpoint, 503)",
  "priority": 1,
  "request": {
    "method": "ANY",
    "urlPathPattern": "/ai/.*",
    "headers": { "X-Mock-Scenario": { "equalTo": "error" } }
  },
  "response": {
    "status": 503,
    "headers":{"Content-Type":"application/json; charset=utf-8"},
    "jsonBody": { "error": { "code": "provider_unavailable", "message": "Mock AI provider failure" } }
  }
}
