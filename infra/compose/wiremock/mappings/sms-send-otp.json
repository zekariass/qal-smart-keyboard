{
  "name": "sms: send OTP",
  "priority": 5,
  "request": { "method": "POST", "urlPath": "/sms/v1/messages" },
  "response": {
    "status": 202,
    "headers":{"Content-Type":"application/json; charset=utf-8"},
    "jsonBody": {
      "message_id": "{{randomValue type='UUID'}}",
      "status": "queued",
      "to": "{{jsonPath request.body '$.to'}}"
    },
    "transformers": ["response-template"]
  }
}
